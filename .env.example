# Copy to .env and adjust. Every variable maps to forge.core.config.Settings.

# postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://forge:forge@localhost:5433/forge

# At least 32 bytes. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-the-output-of-openssl-rand-hex-32
# Optional Fernet key for private notes; derived from SECRET_KEY when empty.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
INVITATION_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Email via Resend; leave the key empty to skip sending (emails are logged).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@kamilimu.org
EMAIL_FROM_NAME=KamiLimu
# Where replies go; leave empty to send without a Reply-To header.
EMAIL_REPLY_TO=
# Absolute URL of the email logo; defaults to $FRONTEND_URL/logos/kamilimu-wordmark.png
EMAIL_LOGO_URL=

# Background jobs (window closing, reminders, email dispatch, snapshots)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300
NOTIFICATION_MAX_ATTEMPTS=5

RATE_LIMIT_ENABLED=true
# Reverse proxies in front of the app (Render: 1); 0 ignores X-Forwarded-For
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_AUTH_TIMES=10
RATE_LIMIT_AUTH_SECONDS=60

# Programme rules
DEFAULT_GRADUATION_THRESHOLD=80
GRADUATION_WARNING_MARGIN=5
DEFAULT_SESSION_POINTS=10
THURSDAY_WINDOW_HOURS=24
SATURDAY_WINDOW_HOURS=48
PEER_MENTORSHIP_WINDOW_HOURS=72
OVERRIDE_EXTENSION_HOURS=48
EXTRA_ACTIVITY_DEFAULT_POINTS={"academic": 5, "event": 5, "opportunity": 5, "consultation": 5}
DEFAULT_SKILL_NAMES=communication,leadership,technical,teamwork,problem_solving,professionalism
